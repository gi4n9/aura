generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ================= ENUMS =================
enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum QuestionType {
  MULTIPLE_CHOICE        // Trắc nghiệm 4 đáp án A/B/C/D
  ESSAY                  // Tự luận/Bài tập nộp file
  TRUE_FALSE             // Đúng/Sai (cụm 4 mệnh đề a,b,c,d)
  FILL_IN_BLANK          // Điền khuyết (nhập kết quả ngắn)
  READING_COMPREHENSION  // Đọc hiểu (câu hỏi dựa trên passage chung)
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PublishStatus {
  ARCHIVED
  DRAFT
  PUBLISHED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum RoadmapNodeStatus {
  LOCKED
  UNLOCKED
  COMPLETED
  SKIPPED
}

enum QuizSource {
  AI_VIDEO        // Tạo tự động từ video
  MANUAL          // Giảng viên nhập thủ công
  WORKSHEET       // AI trích xuất từ phiếu bài tập upload
}

enum QuizDisplayMode {
  AI_ONLY         // Chỉ hiện câu hỏi AI tạo từ video
  WORKSHEET_ONLY  // Chỉ hiện câu hỏi từ phiếu upload
  BOTH            // Hiện cả 2
}

// ================= 1. IDENTITY & ACCESS =================

// Profile map 1-1 với Supabase Auth User
model Profile {
  id        String   @id @default(uuid()) // Link với auth.users.id của Supabase
  email     String   @unique
  fullName  String?
  avatarUrl String?
  role      UserRole @default(STUDENT)
  interests String[] @default([]) // Selected categories e.g. ["backend", "frontend"]
  learningPath Json? // Generated roadmap data

  // Quan hệ Organization (Trường học/Trung tâm)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Quan hệ ngược
  coursesCreated Course[]        @relation("InstructorCourses")
  enrollments    Enrollment[]
  studyPlans     StudyPlanItem[]
  roadmap        UserRoadmap?
  submissions    Submission[]
  chatSessions   ChatSession[]
  videoProgress  VideoProgress[]
  quizResults    QuizResult[]

  // Chat Relations
  // Chat Relations
  directMessagesSent       DirectMessage[]
  conversationParticipations ConversationParticipant[]
  
  // NEW: Study Schedules Config
  studySchedules StudySchedule[]
  
  // Payment History
  purchases      Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tổ chức (Trường học, Trung tâm)
model Organization {
  id          String  @id @default(uuid())
  name        String
  description String?
  logoUrl     String?

  members Profile[]
  courses Course[]

  createdAt DateTime @default(now())
}

// ================= 2. COURSE MANAGEMENT =================

model Course {
  id           String       @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String?
  price        Decimal      @default(0)
  isFree       Boolean      @default(true) // Helper flag: true if price == 0
  status       CourseStatus @default(DRAFT)

  // Ai sở hữu khóa học này?
  instructorId String
  instructor   Profile @relation("InstructorCourses", fields: [instructorId], references: [id])

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Phân loại
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  // Nội dung
  chapters    Chapter[]
  enrollments Enrollment[]
  quizResults QuizResult[]
  purchases   Purchase[]
  
  // NEW: Relation to Study Schedule
  includedInSchedules StudyScheduleCourse[]
  
  // NEW: Roadmap Relations
  prerequisitesFor CoursePrerequisite[] @relation("PrerequisiteToCourse")
  prerequisites    CoursePrerequisite[] @relation("CourseToPrerequisite")
  roadmapNodes     UserRoadmapNode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Chapter {
  id       String        @id @default(uuid())
  title    String
  courseId String
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
  status   PublishStatus @default(DRAFT)
  position Int // Để sắp xếp thứ tự chương
}

model Lesson {
  id        String  @id @default(uuid())
  title     String
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  position  Int

  youtubeVideoId String? 
  duration       Int?    
  transcript     String? @db.Text 
  mindMapData    Json?   // GIỮ LẠI: Lưu JSON cho đồ họa Mindmap của React Flow
  flashcards     Flashcard[]

  timeline        Json? 
  translations    Json? 
  questions       Question[]
  quizDisplayMode QuizDisplayMode @default(BOTH)
  examCode        String?         // Mã đề của file worksheet được upload

  studyPlanItems  StudyPlanItem[]
  videoProgress   VideoProgress[]
  quizResults     QuizResult[]
  videoEmbeddings VideoEmbedding[]
  passages        Passage[]

  createdAt DateTime @default(now())
}

// ================= FLASHCARDS (BẢNG ĐỘC LẬP) =================
model Flashcard {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  front     String   @db.Text
  back      String   @db.Text
  timestamp Int?     // Thời điểm xuất hiện trong video (giây)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lessonId]) // Đánh index để truy vấn theo bài học cực nhanh
}

// ================= VIDEO PROGRESS TRACKING =================
model VideoProgress {
  id        String  @id @default(uuid())
  
  userId    String
  user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lessonId  String
  lesson    Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  // Progress data
  currentTime     Int       @default(0)  // Thời điểm hiện tại (giây)
  duration        Int       @default(0)  // Tổng thời lượng video (giây)
  percentage      Float     @default(0)  // % đã xem (0-100)
  isCompleted     Boolean   @default(false) // Đã xem xong (>= 90%)
  
  lastWatchedAt   DateTime  @default(now()) // Lần cuối xem
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, lessonId]) // Mỗi user chỉ có 1 record per lesson
  @@index([userId])
  @@index([lessonId])
}

model Question {
  id       String @id @default(uuid())
  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  content   String       @db.Text // Nội dung câu hỏi
  contentImageUrl String?    // URL ảnh nhúng vào đề (công thức, hình vẽ, bảng biểu)
  timestamp Int? // Thời điểm xuất hiện trong video (giây). Null nếu là bài tập cuối bài.
  type      QuestionType

  // Cho trắc nghiệm
  options       Json? // Mảng các lựa chọn ["A...", "B..."]
  correctAnswer String? // Đáp án đúng

  // Cho AI
  aiExplanation String? // Giải thích của AI cho đáp án đúng/gợi ý chấm điểm

  // === ĐÁP ÁN MẪU (cho câu tự luận / đọc hiểu) ===
  modelAnswer        String?  @db.Text  // Đáp án mẫu dạng text/Markdown (bài văn mẫu, ý chính, rubric)
  modelAnswerFileUrl String?            // URL file đáp án mẫu (PDF/Word/Ảnh) trên Storage

  quizSource    QuizSource   @default(AI_VIDEO)  // Nguồn gốc câu hỏi

  // === MỚI: Hỗ trợ đa dạng câu hỏi ===
  subjectHint   String?  // Gợi ý môn học: "toan", "ngu_van", "anh_van", "ly", "hoa", "sinh", "su", "dia", "gdcd"

  // Quan hệ Passage (Đọc hiểu): 1 Passage → N Questions
  passageId     String?
  passage       Passage? @relation(fields: [passageId], references: [id], onDelete: SetNull)

  // Quan hệ SubItem (Đúng/Sai cụm): 1 Question → N SubItems
  subItems      SubItem[]

  isArchived  Boolean      @default(false)
  submissions Submission[]
  createdAt   DateTime     @default(now())
}

// ================= PASSAGE (ĐỌC HIỂU) =================
// Lưu đoạn văn bản/ngữ liệu dùng chung cho nhóm câu hỏi đọc hiểu
model Passage {
  id        String   @id @default(uuid())
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  title     String?  // VD: "Đọc hiểu bài Sóng - Xuân Quỳnh"
  content   String   @db.Text // Nội dung đoạn văn/ngữ liệu

  questions Question[]
  createdAt DateTime @default(now())

  @@index([lessonId])
}

// ================= SUBITEM (ĐÚNG/SAI CỤM) =================
// Lưu từng mệnh đề a, b, c, d cho câu hỏi dạng TRUE_FALSE
model SubItem {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label      String   // "a", "b", "c", "d"
  content    String   @db.Text // Nội dung mệnh đề
  isCorrect  Boolean  // true = Đúng, false = Sai
  knowledge  String?  // Tag kiến thức riêng (tùy chọn, cho AI tracking)

  position   Int      @default(0) // Thứ tự hiển thị
  createdAt  DateTime @default(now())

  @@index([questionId])
}

// ================= 2.1 CATEGORIES =================
model Category {
  id          String   @id @default(uuid())
  name        String   // Tên danh mục (Ví dụ: "Lập trình", "Ngoại ngữ")
  slug        String   @unique // URL friendly (ví dụ: "lap-trinh", "ngoai-ngu")
  description String?
  icon        String?  // Icon/Image URL

  // Hierarchy (Danh mục cha - con)
  parentId    String?
  parent      Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]  @relation("CategoryHierarchy")

  // Courses in this category
  courses     Course[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================= 3. LEARNING & INTERACTION =================

// Ghi nhận việc mua/đăng ký khóa học
model Enrollment {
  id       String  @id @default(uuid())
  userId   String
  user     Profile @relation(fields: [userId], references: [id])
  courseId String
  course   Course  @relation(fields: [courseId], references: [id])

  progress Int      @default(0) // % hoàn thành
  joinedAt DateTime @default(now())

  @@unique([userId, courseId])
}

// Giao dịch mua bán (Payment History)
model Purchase {
  id          String   @id @default(uuid())
  userId      String
  user        Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  courseId    String?
  course      Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Bundle Fields
  isBundle        Boolean  @default(false)
  bundleCourseIds String[] @default([])

  amount      Decimal  // Số tiền thực trả
  currency    String   @default("VND") // VND, USD
  
  // Payment Gateway Info
  provider       String   @default("STRIPE") // STRIPE, VNPAY, MOMO
  transactionId  String?  // Transaction ID từ cổng thanh toán (ví dụ: Stripe Payment Intent ID)
  status         PurchaseStatus @default(PENDING)
  
  errorLog       String?  // Lưu lỗi nếu có
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId])
  @@index([courseId])
}

// Lịch học (Study Plan) - INDIVIDUAL ITEMS
model StudyPlanItem {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  lessonId String
  lesson   Lesson @relation(fields: [lessonId], references: [id])
  
  // Link to parent schedule if needed, but keeping it loose is also fine
  studyScheduleId String?
  studySchedule   StudySchedule? @relation(fields: [studyScheduleId], references: [id])

  scheduledAt DateTime // Thời gian user dự kiến học
  isCompleted Boolean  @default(false)
  completedAt DateTime? // Thời điểm hoàn thành bài học (dùng tính thống kê tuần/tháng)

  // Dùng để hiển thị trên UI Calendar
  note String?
}

// NEW: STUDY SCHEDULE CONFIGURATION (One user can have multiple "Plans" e.g. "Summer Plan", "Exam Prep")
model StudySchedule {
    id        String @id @default(uuid())
    userId    String
    user      Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
    
    name      String // e.g., "Fullstack Roadmap"
    
    // Preferences
    startDate      DateTime
    targetEndDate  DateTime?
    
    // Days of week available: [1, 3, 5] (Mon, Wed, Fri) stored as Int[] is tricky in Postgres w/ Prisma arrays sometimes, using simple version or JSON
    // Or just "1,3,5" string
    availableDays  Int[] 
    
    dailyLearningMinutes Int? // e.g. 60
    
    // Status
    isActive  Boolean @default(true)
    
    // Relations
    courses   StudyScheduleCourse[]
    items     StudyPlanItem[]
    
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model StudyScheduleCourse {
    studyScheduleId String
    studySchedule   StudySchedule @relation(fields: [studyScheduleId], references: [id], onDelete: Cascade)
    
    courseId String
    course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
    
    priority Int? // Order to learn: 1, 2, 3
    
    @@id([studyScheduleId, courseId])
}


// Bài làm của học sinh
model Submission {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id])

  questionId String
  question   Question @relation(fields: [questionId], references: [id])

  answerText String? @db.Text // Câu trả lời text
  fileUrl    String? // Link bài tập upload lên Supabase Storage

  // AI Grading
  score    Float? // Điểm số do AI chấm
  feedback String?   @db.Text // Nhận xét chi tiết của AI
  gradedAt DateTime?

  // Chấm điểm chi tiết (Giảng viên / AI)
  gradedBy    String?  // userId của giảng viên chấm (null = AI hoặc auto)
  isAiGraded  Boolean  @default(false) // true nếu điểm do AI gợi ý
  isFinalized Boolean  @default(false) // true khi giảng viên đã duyệt/xác nhận điểm cuối cùng

  createdAt DateTime @default(now())
}

// Tổng hợp kết quả làm bài tập của học viên theo từng bài học
model QuizResult {
  id        String   @id @default(uuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  // Denormalize để query nhanh theo khóa học
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  score          Float    @default(0)   // Điểm số (0-100 hoặc theo thang điểm)
  totalQuestions Int      @default(0)
  correctAnswers Int      @default(0)
  isPassed       Boolean  @default(false) // Đạt yêu cầu hay chưa
  
  attemptCount   Int      @default(1)   // Số lần làm bài
  
  lastAttemptAt  DateTime @default(now())
  
  @@unique([userId, lessonId]) // Mỗi user chỉ lưu 1 kết quả tổng hợp cho 1 bài học
  @@index([courseId])
  @@index([userId])
}

// ================= 4. AI CHAT & MEMORY =================

model ChatSession {
  id     String  @id @default(uuid())
  userId String
  user   Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Context: Chat này về khóa học/bài học nào? (Optional)
  courseId String? // Nếu null thì là chat general, nếu có thì AI load context khóa học đó
  lessonId String? // Lịch sử đoạn chat cụ thể gắn liền với bài học nào

  title    String? // Tên đoạn hội thoại (Auto generate bởi AI)
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String      @id @default(uuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role    String // 'user' hoặc 'assistant'
  content String @db.Text

  // Token usage tracking (Optional nhưng tốt cho quản lý chi phí)
  tokensUsed Int?

  createdAt DateTime @default(now())
}

// ================= 5. USER CHAT (MESSENGER STYLE) =================

model Conversation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     DirectMessage[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  hasSeenLatest  Boolean      @default(false)
  
  @@unique([conversationId, userId])
}

model DirectMessage {
  id             String       @id @default(uuid())
  content        String       @db.Text
  fileUrl        String?
  
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId       String
  sender         Profile      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  
  deleted        Boolean      @default(false)

  @@index([conversationId])
  @@index([senderId])
}

// ================= 6. VECTOR SEARCH =================
model VideoEmbedding {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String   @map("lesson_id")
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  content   String   @db.Text
  startTime Float    @map("start_time")
  endTime   Float    @map("end_time")
  
  // Unsupported type for vector, handle via raw SQL or Supabase client
  embedding Unsupported("vector(3072)")?
  
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("video_embeddings")
}

// ================= 7. DYNAMIC ROADMAP =================

model CoursePrerequisite {
  courseId         String
  prerequisiteId   String

  course           Course @relation("CourseToPrerequisite", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisite     Course @relation("PrerequisiteToCourse", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@id([courseId, prerequisiteId])
}

model UserRoadmap {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  progressPercentage Int      @default(0)
  totalCourses       Int      @default(0)
  totalEstimatedHours Int     @default(0)

  nodes              UserRoadmapNode[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model UserRoadmapNode {
  id             String      @id @default(uuid())
  roadmapId      String
  roadmap        UserRoadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  stageLevel     Int         // 1, 2, 3...
  status         RoadmapNodeStatus @default(LOCKED)
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([roadmapId, courseId])
}

model OcrCache {
  hash      String   @id
  type      String   // "pdf" or "image"
  text      String
  meta      Json     // Lưu { confidence, textLength, wordCount, vietnameseRatio }
  createdAt DateTime @default(now())
}
