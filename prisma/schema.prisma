// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String  @id @default(uuid()) // Dùng UUID bảo mật hơn số thứ tự (1,2,3)
  email     String  @unique
  name      String? // Có thể null (người dùng chưa cập nhật tên)
  avatarUrl String? // Link ảnh đại diện
  role      String  @default("USER") // Phân quyền: USER hoặc ADMIN

  createdAt DateTime @default(now()) // Thời gian tạo
  updatedAt DateTime @updatedAt // Tự động cập nhật khi sửa đổi
}

model Playlist {
  id          String   @id @default(uuid())
  title       String
  channel     String
  totalVideos Int
  crawlTime   DateTime
  createdAt   DateTime @default(now())

  // Quan hệ 1-nhiều với Video
  videos Video[]

  @@map("playlists") // Tên bảng trong DB
}

model Video {
  id        String @id @default(uuid())
  stt       Int // Số thứ tự trong playlist
  title     String
  url       String
  youtubeId String @unique // ID của youtube (vd: 0SJE9dYdpps)

  // Các trường phục vụ cho AI (để null ban đầu, sau này update sau)
  transcript String? @db.Text // Nội dung text của video
  summary    String? @db.Text // Tóm tắt do AI tạo

  // Khóa ngoại liên kết với Playlist
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("videos")
}
