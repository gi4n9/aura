// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Bảng User giữ nguyên
model User {
  id        String  @id @default(uuid())
  email     String  @unique
  name      String?
  avatarUrl String?
  role      String  @default("USER")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Bảng Playlist giữ nguyên
model Playlist {
  id          String   @id @default(uuid())
  title       String
  channel     String
  totalVideos Int
  crawlTime   DateTime
  createdAt   DateTime @default(now())

  videos Video[]

  @@map("playlists")
}

// Bảng Video (Cập nhật đầy đủ cho AI)
model Video {
  id        String @id @default(uuid())
  stt       Int
  title     String
  url       String
  youtubeId String @unique

  // --- CÁC TRƯỜNG AI (NEW) ---
  // 1. Transcript: Nội dung văn bản của video (lấy từ Youtube hoặc Whisper)
  transcript String? @db.Text

  // 2. Summary: Tóm tắt nội dung do AI sinh ra
  summary String? @db.Text

  // 3. MindMap: Mã nguồn biểu đồ tư duy (MermaidJS)
  mindMap String? @db.Text

  // 4. Questions: Danh sách câu hỏi ôn tập (Lưu dạng JSON)
  questions Json?

  // 5. Trạng thái: Đánh dấu video này đã được AI phân tích chưa
  isAnalyzed Boolean @default(false)

  // Khóa ngoại
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("videos")
}
